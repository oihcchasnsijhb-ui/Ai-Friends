# GEMINI_API_KEY: Required for Gemini AI text, TTS, transcription, and Live API voice calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The public URL where this application is hosted.
APP_URL=

# SESSION_SECRET: HMAC signing secret for Bearer session tokens (auto-generated in memory if unset).
SESSION_SECRET=

# ADMIN_PASSCODE: Passcode for unlocking the Admin Dashboard in production.
# If unset on first run, use the inline Admin Claim setup in the Admin view.
ADMIN_PASSCODE=

# RAZORPAY (India INR Billing)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# STRIPE (International USD Billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# POSTGRESQL & REDIS (Optional external production persistence; local SQLite is active by default)
DATABASE_URL=
REDIS_URL=
